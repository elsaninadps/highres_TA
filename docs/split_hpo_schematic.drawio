        <mxCell id="formula" value="&lt;b&gt;Uncertainty decomposition&lt;/b&gt; (per test row and quantile, population variance):&amp;nbsp;&amp;nbsp;Var&lt;sub&gt;total&lt;/sub&gt; = Var&lt;sub&gt;k&lt;/sub&gt;( mean&lt;sub&gt;r&lt;/sub&gt; q&lt;sub&gt;k,r&lt;/sub&gt; ) + mean&lt;sub&gt;k&lt;/sub&gt;( Var&lt;sub&gt;r&lt;/sub&gt; q&lt;sub&gt;k,r&lt;/sub&gt; ) = &lt;b&gt;split variance&lt;/b&gt; + &lt;b&gt;HPO variance&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="702" width="1070" height="40" as="geometry" />
        </mxCell>
